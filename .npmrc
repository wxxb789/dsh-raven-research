# No `registry=` line on purpose. The lockfile already pins every dependency by
# integrity hash, so naming a registry here adds no reproducibility — it only
# overrides the developer's own configuration. A machine behind a corporate
# mirror then cannot install at all, which is not hypothetical: on the machine
# this hardening pass was done, the pinned public registry failed its TLS
# handshake while the user-level mirror installed the identical packages.
# CI, which has no user configuration, still resolves the public default.
auto-install-peers=false
strict-peer-dependencies=false
manage-package-manager-versions=false
package-manager-strict=false
