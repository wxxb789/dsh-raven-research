{
  "name": "dsh-raven-research",
  "version": "0.1.0",
  "description": "DeepSeek Harness plugin for progressive, source-grounded deep research, writing, and learning: steerable checkpoints and citations verified against retrieved sources",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wxxb789/dsh-raven-research.git"
  },
  "homepage": "https://github.com/wxxb789/dsh-raven-research#readme",
  "bugs": {
    "url": "https://github.com/wxxb789/dsh-raven-research/issues"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "cordis-plugin",
    "ai-agent",
    "llm",
    "deep-research",
    "research-agent",
    "citations",
    "source-grounding",
    "rag",
    "academic-writing",
    "writing-assistant",
    "learning",
    "typescript"
  ],
  "sideEffects": false,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "examples/*.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "build": "tsdown",
    "prepack": "tsdown",
    "lint": "oxlint --deny-warnings src tests scripts tsdown.config.ts vitest.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:dsh": "pnpm run build && tsx scripts/run-dsh-test.ts",
    "test:pack": "tsx scripts/verify-packed-install.ts",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build",
    "check:release": "pnpm run check && pnpm run test:pack && pnpm run test:dsh"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-settings": "*",
    "@deepseek-ai/schemastery": "*"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-settings": "0.0.1-rc.2",
    "@deepseek-ai/schemastery": "3.18.1-rc.1",
    "@types/node": "22.20.0",
    "oxlint": "1.76.0",
    "tsdown": "0.22.2",
    "tsx": "4.22.4",
    "typescript": "6.0.3",
    "vitest": "4.1.8"
  },
  "dshRaven": {
    "harnessVersion": "0.1.0-rc.8",
    "harnessCommit": "141eb6fef83422698aef7a981029e843e8161534",
    "plane": "agent",
    "publishesService": false
  }
}
